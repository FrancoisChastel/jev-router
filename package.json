{
  "name": "@french-castle/jev-router",
  "version": "0.1.0",
  "description": "Route each coding-agent turn to the cheapest model that can finish it. Switchyard-style execution signals, TypeSafe's jev as the judge, and honest cost accounting. Works with Claude Code, Codex, OpenCode, and Pi.",
  "keywords": [
    "llm",
    "router",
    "model-routing",
    "jev",
    "typesafe",
    "switchyard",
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "pi-package",
    "openrouter",
    "vercel-ai-gateway",
    "cost"
  ],
  "homepage": "https://github.com/FrancoisChastel/jev-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-router.git"
  },
  "bugs": {
    "url": "https://github.com/FrancoisChastel/jev-router/issues"
  },
  "author": "Francois Chastel",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev-router": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugins",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./judge": {
      "types": "./dist/judge/index.d.ts",
      "default": "./dist/judge/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./adapters/pi": {
      "types": "./dist/adapters/pi/index.d.ts",
      "default": "./dist/adapters/pi/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon/index.d.ts",
      "default": "./dist/daemon/index.js"
    },
    "./adapters/opencode": {
      "types": "./dist/adapters/opencode/index.d.ts",
      "default": "./dist/adapters/opencode/index.js"
    },
    "./measure": {
      "types": "./dist/measure/index.d.ts",
      "default": "./dist/measure/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/core/index.ts src/judge/index.ts src/runtime/index.ts src/daemon/index.ts src/measure/index.ts src/adapters/pi/index.ts src/adapters/opencode/index.ts src/cli/index.ts --outdir dist --target node --splitting --external '@earendil-works/*' --external '@opencode-ai/*' && bun build src/adapters/opencode/index.ts --outfile dist/adapters/opencode/plugin.js --target node --external '@opencode-ai/*' && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint && bun test && bun run build && node scripts/cancel-smoke.mjs",
    "prepublishOnly": "bun run check && bun run build"
  },
  "pi": {
    "extensions": [
      "./dist/adapters/pi/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@opencode-ai/plugin": "^1.18.32",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
